  "packages/test-project/rolldown.config.ts": "import { defineConfig } from 'rolldown';

export default defineConfig([
  {
    tsconfig: 'tsconfig.lib.json',
    input: 'src/greengrass/my-component/main.ts',
    output: {
      file: '../../dist/packages/test-project/bundle/greengrass/my-component/index.js',
      format: 'cjs',
      codeSplitting: false,
    },
    platform: 'node',
  },
]);
",
  "packages/test-project/src/greengrass/my-component/main.ts": "const RUN_INTERVAL_MS = 30_000;

export function runOnce(sequence: number): void {
  console.log(
    \`[com.proj.MyComponent] heartbeat \${sequence} at \${new Date().toISOString()}\`,
  );
}

async function main(): Promise<void> {
  let sequence = 0;
  for (;;) {
    runOnce(sequence);
    sequence += 1;
    await new Promise((resolve) => setTimeout(resolve, RUN_INTERVAL_MS));
  }
}

main();
",
