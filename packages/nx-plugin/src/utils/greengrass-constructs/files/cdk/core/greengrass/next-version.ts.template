import { Construct } from 'constructs';
import * as url from 'node:url';
import { CustomResource, Duration, Stack } from 'aws-cdk-lib';
import { PolicyStatement } from 'aws-cdk-lib/aws-iam';
import { Code, Function, Runtime } from 'aws-cdk-lib/aws-lambda';
import { Provider } from 'aws-cdk-lib/custom-resources';

const GreengrassNextVersionProviderKey = '__GreengrassNextVersionProvider__';

export interface GreengrassNextVersionProps {
  /** Name of the Greengrass component whose next version is resolved. */
  readonly componentName: string;
  /** Part of the highest published strict M.m.p version to increment. */
  readonly strategy: 'patch' | 'minor' | 'major';
  /** Opaque digest of the submitted recipe and built artifact content. */
  readonly contentSha256: string;
  /** Artifact bucket name, which can be a deploy-time CloudFormation token. */
  readonly bucketName: string;
}

/**
 * Stack-scoped provider for {@link GreengrassNextVersion}.
 *
 * Every next-version resource in a stack shares one Lambda function and
 * provider, which avoids duplicating deployment assets and IAM roles.
 */
class GreengrassNextVersionProvider extends Construct {
  static ensure(scope: Construct): GreengrassNextVersionProvider {
    const stack = Stack.of(scope);
    return (
      (stack.node.tryFindChild(
        GreengrassNextVersionProviderKey,
      ) as GreengrassNextVersionProvider) ??
      new GreengrassNextVersionProvider(
        stack,
        GreengrassNextVersionProviderKey,
      )
    );
  }

  public readonly serviceToken: string;

  private constructor(scope: Construct, id: string) {
    super(scope, id);

    const onEvent = new Function(this, 'OnEvent', {
      runtime: <%- nodeRuntime %>,
      handler: 'index.handler',
      timeout: Duration.minutes(2),
      code: Code.fromAsset(
        url.fileURLToPath(
          new URL('./next-version', <% if (esm) { %>import.meta.url<% } else { %>require('url').pathToFileURL(__filename).href<% } %>),
        ),
      ),
    });
    const stack = Stack.of(this);
    onEvent.addToRolePolicy(
      new PolicyStatement({
        actions: [
          'greengrass:DescribeComponent',
          'greengrass:ListComponentVersions',
        ],
        resources: [
          `arn:${stack.partition}:greengrass:${stack.region}:${stack.account}:components:*`,
        ],
      }),
    );

    const provider = new Provider(this, 'Provider', {
      onEventHandler: onEvent,
    });
    this.serviceToken = provider.serviceToken;
  }
}

/**
 * Resolves the version and content identity for an automatically versioned
 * Greengrass component at deploy time.
 *
 * CloudFormation re-invokes this resource only when one of its properties
 * changes. Its stable physical resource ID and no-op Delete keep an unchanged
 * component version stable across stack updates and deletion.
 */
export class GreengrassNextVersion extends Construct {
  /** The deploy-time version resolved from the Greengrass registry. */
  public readonly version: string;

  /** Bucket-scoped content identity returned by the shared resolver. */
  public readonly contentKey: string;

  constructor(
    scope: Construct,
    id: string,
    props: GreengrassNextVersionProps,
  ) {
    super(scope, id);

    const resource = new CustomResource(this, 'Resource', {
      serviceToken: GreengrassNextVersionProvider.ensure(this).serviceToken,
      resourceType: 'Custom::GreengrassNextVersion',
      properties: {
        ComponentName: props.componentName,
        Strategy: props.strategy,
        ContentSha256: props.contentSha256,
        BucketName: props.bucketName,
      },
    });
    this.version = resource.getAttString('Version');
    this.contentKey = resource.getAttString('ContentKey');
  }
}
