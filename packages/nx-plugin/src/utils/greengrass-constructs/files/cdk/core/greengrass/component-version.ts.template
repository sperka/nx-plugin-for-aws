import { createHash } from 'node:crypto';
import { readFileSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
import { RemovalPolicy } from 'aws-cdk-lib';
import { CfnComponentVersion } from 'aws-cdk-lib/aws-greengrassv2';
import { BucketDeployment, Source } from 'aws-cdk-lib/aws-s3-deployment';
import { Construct } from 'constructs';
import yaml from 'js-yaml';
import type { GreengrassArtifactBucket } from './artifact-bucket<% if (esm) { %>.js<% } %>';
import {
  readRecipeSummary,
  substituteArtifactUris,
} from './recipe<% if (esm) { %>.js<% } %>';

export interface GreengrassComponentVersionProps {
  /**
   * Directory holding the one resolved recipe YAML the `<c>-artifact` target
   * writes (`greengrass-build/recipes`). Read at synth time; a per-component
   * subclass pins this via `import.meta.url` against its own file location.
   */
  readonly recipesDir: string;

  /**
   * Directory holding the `<c>-artifact` target's artifact tree
   * (`greengrass-build/artifacts`), containing one file per manifest platform
   * at `<artifactsDir>/<ComponentName>/<ComponentVersion>/`.
   */
  readonly artifactsDir: string;

  /** The shared artifact bucket this version's artifact is uploaded to. */
  readonly bucket: GreengrassArtifactBucket;

  /**
   * Applied to both `DeletionPolicy` and `UpdateReplacePolicy` on the
   * `AWS::GreengrassV2::ComponentVersion` resource. Component versions are
   * immutable, so a stack replacement or deletion must never take an
   * already-published version's CloudFormation-managed record with it -
   * override to `DESTROY` only for short-lived e2e fixtures.
   *
   * @default RemovalPolicy.RETAIN
   */
  readonly removalPolicy?: RemovalPolicy;
}

/** Reads `dir`, returning the single file whose name passes `predicate`. */
const findSingleFile = (
  dir: string,
  description: string,
  predicate: (name: string) => boolean = () => true,
): string => {
  let entries: string[];
  try {
    entries = readdirSync(dir).filter(predicate);
  } catch {
    throw new Error(
      `No ${description} found at "${dir}" - run the component's "-artifact" target first.`,
    );
  }
  if (entries.length !== 1) {
    throw new Error(
      `Expected exactly one ${description} in "${dir}", found ${entries.length}.`,
    );
  }
  return join(dir, entries[0]);
};

/** Reads `dir`, returning every file name sorted, throwing when it holds none. */
const listFilesSorted = (dir: string, description: string): string[] => {
  let entries: string[];
  try {
    entries = readdirSync(dir);
  } catch {
    throw new Error(
      `No ${description} found at "${dir}" - run the component's "-artifact" target first.`,
    );
  }
  if (entries.length === 0) {
    throw new Error(
      `Expected at least one ${description} in "${dir}", found 0 - run the component's "-artifact" target first.`,
    );
  }
  return entries.sort();
};

/**
 * Synth-time guard against two `GreengrassComponentVersion` constructs in the
 * same synth claiming the same (`ComponentName`, `ComponentVersion`) pair
 * with different content. Module-scoped, so it resets between separate `cdk
 * synth` processes - it is not, and cannot be, a check against what's already
 * published in the target AWS account (synth has no AWS credentials or
 * network access). That check happens at deploy time instead, for free:
 * `AWS::GreengrassV2::ComponentVersion` replaces on any `InlineRecipe` change
 * (versions are immutable), and `CreateComponentVersion` itself rejects a
 * resubmission of an existing version with different content - so
 * CloudFormation fails the deployment rather than silently corrupting an
 * already-published version. The hashed `destinationKeyPrefix` below is what
 * protects the S3 *bytes* specifically: a content change always produces a
 * different key, so a rebuild can never overwrite an object an
 * already-published version's artifact URI still points at.
 */
const publishedHashesByVersion = new Map<string, string>();

const assertNoSynthTimeVersionDrift = (
  componentName: string,
  componentVersion: string,
  sha256: string,
  recipePath: string,
): void => {
  const key = `${componentName}@${componentVersion}`;
  const previousHash = publishedHashesByVersion.get(key);
  if (previousHash !== undefined && previousHash !== sha256) {
    throw new Error(
      `Two different artifacts both claim to be ${key} in this synth ` +
        `("${recipePath}" hashes to ${sha256}, a previous construct hashed to ${previousHash}). ` +
        `Component versions are immutable - bump ComponentVersion in recipe.yaml before rebuilding.`,
    );
  }
  publishedHashesByVersion.set(key, sha256);
};

/**
 * Longest `destinationKeyPrefix` `BucketDeployment` accepts before throwing
 * at synth time - measured, not documented, against aws-cdk-lib 2.268.0
 * (`node_modules/aws-cdk-lib/aws-s3-deployment/lib/bucket-deployment.js`).
 * That constructor tags the destination bucket with a key
 * `aws-cdk:cr-owned:<destinationKeyPrefix>:<8 hex chars>` (the literal is 16
 * characters, the two colons add 2, and the construct-address suffix is
 * always exactly 8 - none of that varies with this prefix), then throws once
 * the tag key exceeds 128 characters. Solving for the prefix:
 * 128 - 16 - 2 - 8 = 102. Synthesizing `BucketDeployment` directly at prefix
 * lengths 100-105 against this exact aws-cdk-lib version confirms it: 102
 * passes, 103 throws - even though CDK's own thrown message claims
 * "<=104 characters" (off by 2). This guard uses the measured 102, not the
 * quoted 104, so it never lets through a prefix CDK's own check would still
 * reject.
 */
const MAX_DESTINATION_KEY_PREFIX_LENGTH = 102;

/**
 * Synth-time guard against a `destinationKeyPrefix` too long for
 * `BucketDeployment` to accept (see {@link MAX_DESTINATION_KEY_PREFIX_LENGTH}).
 * Greengrass's own `CreateComponentVersion` allows a `ComponentName` up to
 * 128 characters - well past what this prefix can carry once its fixed
 * 64-character content hash and three "/" separators are accounted for - and
 * the generator's own validator enforces only that service limit, so this
 * must fail before `BucketDeployment` does, naming the actual culprit
 * (`ComponentName` / `ComponentVersion`) instead of CDK's generic, and
 * numerically wrong, tag-key error.
 */
const assertArtifactKeyPrefixFits = (
  componentName: string,
  componentVersion: string,
  destinationKeyPrefix: string,
): void => {
  if (destinationKeyPrefix.length <= MAX_DESTINATION_KEY_PREFIX_LENGTH) {
    return;
  }
  const overBy =
    destinationKeyPrefix.length - MAX_DESTINATION_KEY_PREFIX_LENGTH;
  throw new Error(
    `ComponentName "${componentName}" (${componentName.length} characters) and ` +
      `ComponentVersion "${componentVersion}" (${componentVersion.length} characters) ` +
      `produce an artifact key prefix "${destinationKeyPrefix}" that is ${destinationKeyPrefix.length} ` +
      `characters long, exceeding the ${MAX_DESTINATION_KEY_PREFIX_LENGTH} character limit CDK's ` +
      `BucketDeployment enforces on it (the prefix always carries a fixed 64-character content hash ` +
      `plus three "/" separators, on top of ComponentName and ComponentVersion). Shorten ` +
      `ComponentName, ComponentVersion, or both by at least ${overBy} character(s).`,
  );
};

/**
 * Publishes one Greengrass component version: reads the resolved recipe and
 * artifact a component's `<c>-artifact` target wrote, uploads the artifact to
 * the shared {@link GreengrassArtifactBucket}, and emits an
 * `AWS::GreengrassV2::ComponentVersion` with the recipe's artifact URI
 * placeholders substituted for the real (deploy-time-resolvable) location.
 */
export class GreengrassComponentVersion extends Construct {
  public readonly componentName: string;
  public readonly componentVersion: string;
  public readonly cfnComponentVersion: CfnComponentVersion;

  constructor(
    scope: Construct,
    id: string,
    props: GreengrassComponentVersionProps,
  ) {
    super(scope, id);

    const removalPolicy = props.removalPolicy ?? RemovalPolicy.RETAIN;

    const recipePath = findSingleFile(
      props.recipesDir,
      'resolved recipe',
      (name) => name.endsWith('.yaml') || name.endsWith('.yml'),
    );
    const { componentName, componentVersion, raw } = readRecipeSummary(
      readFileSync(recipePath, 'utf-8'),
      recipePath,
    );

    const artifactDir = join(
      props.artifactsDir,
      componentName,
      componentVersion,
    );
    const artifactFileNames = listFilesSorted(
      artifactDir,
      `artifact for ${componentName}@${componentVersion}`,
    );
    const sha256ByName = new Map(
      artifactFileNames.map((name) => [
        name,
        createHash('sha256')
          .update(readFileSync(join(artifactDir, name)))
          .digest('hex'),
      ]),
    );
    // COMPATIBILITY HINGE - do not "simplify" this branch away. With exactly
    // one artifact the prefix segment stays that artifact's OWN sha256, byte
    // for byte the value every already-published version was keyed by.
    // Routing the one-file case through the aggregate would re-key every
    // existing component; a re-keyed artifact URI changes InlineRecipe, which
    // CloudFormation can only apply by replacing an immutable version, and
    // CreateComponentVersion then fails with AlreadyExists.
    //
    // With more than one, the prefix covers ALL of the version's artifacts:
    // sorted `<name>:<sha256>` lines joined by "\n", hashed. Sorted, so the
    // key is independent of directory iteration order. Identical formula in
    // the Terraform module.
    const sha256 =
      artifactFileNames.length === 1
        ? sha256ByName.get(artifactFileNames[0])!
        : createHash('sha256')
            .update(
              artifactFileNames
                .map((name) => `${name}:${sha256ByName.get(name)!}`)
                .join('\n'),
            )
            .digest('hex');

    assertNoSynthTimeVersionDrift(
      componentName,
      componentVersion,
      sha256,
      recipePath,
    );

    const destinationKeyPrefix = `${componentName}/${componentVersion}/${sha256}/`;

    assertArtifactKeyPrefixFits(
      componentName,
      componentVersion,
      destinationKeyPrefix,
    );

    // The source is the DIRECTORY holding the artifact, not the artifact
    // itself. `BucketDeployment` unpacks its source asset and syncs the
    // result, so every file lands at `destinationKeyPrefix + <its own name>`
    // and the archive keeps the basename `<c>-artifact` gave it - which the
    // recipe's Run lifecycle script depends on, since the nucleus derives
    // `{artifacts:decompressedPath}/<name>` from the artifact URI's basename.
    // Passing the archive itself with `extract: false` would instead publish
    // it under the CDK asset's own hashed file name, which no recipe can
    // reference.
    //
    // `prune: false`: the hashed prefix is unique to this content, so nothing
    // else could ever share it, and there is nothing to prune.
    // `retainOnDelete` mirrors `removalPolicy` so a stack deletion can't take
    // a retained component version's artifact with it.
    const artifactUpload = new BucketDeployment(this, 'ArtifactUpload', {
      sources: [Source.asset(artifactDir)],
      destinationBucket: props.bucket.bucket,
      destinationKeyPrefix,
      prune: false,
      retainOnDelete: removalPolicy === RemovalPolicy.RETAIN,
    });

    // `bucket.bucketName` is typically an unresolved token; see the doc
    // comment on `substituteArtifactUris` for why embedding it in the YAML
    // string here is safe.
    const substitutedBasenames = substituteArtifactUris(raw, {
      bucketName: props.bucket.bucket.bucketName,
      componentName,
      componentVersion,
      sha256,
    });

    // The recipe names its artifacts; the build names the files. A mismatch in
    // either direction would otherwise only surface on a device: referenced but
    // not built is a failed artifact fetch, built but not referenced is an
    // architecture whose manifest was never added.
    const builtNames = new Set(artifactFileNames);
    // Deduped: one basename may legitimately be referenced by several
    // manifests (a platform-independent bundle serving two architectures).
    const referencedNames = new Set(substitutedBasenames);
    const missing = [...referencedNames].filter((name) => !builtNames.has(name));
    if (missing.length > 0) {
      throw new Error(
        `"${recipePath}" references artifact ${missing
          .map((name) => `"${name}"`)
          .join(', ')}, but the files built for ${componentName}@${componentVersion} are ${artifactFileNames
          .map((name) => `"${name}"`)
          .join(', ')}. Make the recipe's artifact URI end in one of those names.`,
      );
    }
    const unreferenced = artifactFileNames.filter(
      (name) => !referencedNames.has(name),
    );
    if (unreferenced.length > 0) {
      throw new Error(
        `The build produced ${unreferenced
          .map((name) => `"${name}"`)
          .join(', ')} for ${componentName}@${componentVersion}, which no manifest in "${recipePath}" references. Add a manifest whose artifact URI ends in each name, then bump ComponentVersion before re-deploying.`,
      );
    }

    this.cfnComponentVersion = new CfnComponentVersion(this, 'Resource', {
      inlineRecipe: yaml.dump(raw, { lineWidth: -1 }),
    });

    // CloudFormation does not infer this dependency from the token embedded
    // in `InlineRecipe` - referencing the bucket's name is not the same as
    // waiting on the custom resource that populates it. Without this, a
    // fresh deployment can create the component version before the artifact
    // exists at the key it points to.
    this.cfnComponentVersion.node.addDependency(artifactUpload);

    // Applies to both `DeletionPolicy` and `UpdateReplacePolicy` (the default
    // for `applyToUpdateReplacePolicy`) - `InlineRecipe` is a replacement
    // property, so an update-triggered replacement must retain the outgoing
    // resource just as a deletion would.
    this.cfnComponentVersion.applyRemovalPolicy(removalPolicy);

    this.componentName = componentName;
    this.componentVersion = componentVersion;
  }
}
