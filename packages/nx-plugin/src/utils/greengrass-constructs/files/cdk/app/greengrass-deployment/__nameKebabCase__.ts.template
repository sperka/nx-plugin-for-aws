<% if (tokenExchangeRoleArn) { %>import { Role } from 'aws-cdk-lib/aws-iam';
<% } %>import { Construct, type IDependable } from 'constructs';
import {
  GreengrassArtifactBucket,
  GreengrassDeployment,
  type GreengrassDeploymentComponent,
} from '../../core/greengrass/index<% if (esm) { %>.js<% } %>';

export interface <%- nameClassName %>Props {
  /**
   * Components to deploy, keyed by `ComponentName`. Typically imported from
   * this deployment's typed component library
   * (`<%- libraryImportPath %>`).
   */
  readonly components?: Record<string, GreengrassDeploymentComponent>;
}

/**
 * Greengrass deployment infrastructure generated by `greengrass-deployment`
 * for "<%- name %>": a dedicated artifact bucket<% if (artifactBucketImported) { %> (imported)<% } %> and
 * a deployment targeting <%- targetDescription %>.
 *
 * Re-running the generator re-syncs this file to its current options - hand
 * edits here do not survive a re-run. Add your own constructs alongside it in
 * your infra stack instead.
 */
export class <%- nameClassName %> extends Construct {
  public readonly artifactBucket: GreengrassArtifactBucket;
  public readonly deployment: GreengrassDeployment;

  constructor(scope: Construct, id: string, props: <%- nameClassName %>Props = {}) {
    super(scope, id);

    this.artifactBucket = new GreengrassArtifactBucket(this, 'ArtifactBucket', {
<% if (artifactBucketImported) { %>      existingBucketName: '<%- artifactBucketName %>',
<% } %>    });

    this.deployment = new GreengrassDeployment(this, 'Deployment', {
      <%- targetPropLine %>
<% if (parentTargetArn) { %>      parentTargetArn: '<%- parentTargetArn %>',
<% } %><% if (deploymentPoliciesLiteral) { %>      deploymentPolicies: <%- deploymentPoliciesLiteral %>,
<% } %>      components: props.components,
    });
<% if (tokenExchangeRoleArn) { %>
    // Grants the device-side token exchange role read access to every
    // component version this bucket ever holds, so newly deployed components
    // don't need a fresh grant each time.
    this.artifactBucket.grantReadTo(
      Role.fromRoleArn(this, 'TokenExchangeRole', '<%- tokenExchangeRoleArn %>', {
        mutable: true,
      }),
    );
<% } %>  }

  /**
   * Order the deployment after the component versions it references, so the
   * IoT job can't reach core devices before a version exists in the registry.
   */
  public dependOn(...componentVersions: IDependable[]): this {
    this.deployment.dependOn(...componentVersions);
    return this;
  }
}
