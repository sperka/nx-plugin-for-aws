import * as url from 'url';
import { RemovalPolicy } from 'aws-cdk-lib';
import { Construct } from 'constructs';
import {
  type GreengrassArtifactBucket,
  GreengrassComponentVersion,
} from '../../core/greengrass/index<% if (esm) { %>.js<% } %>';

export interface <%- componentNameClassName %>Props {
  /** The bucket this component version's artifact is uploaded to. */
  readonly bucket: GreengrassArtifactBucket;

  /**
   * @default RemovalPolicy.RETAIN
   */
  readonly removalPolicy?: RemovalPolicy;
}

/**
 * Publishes the "<%- componentDisplayName %>" Greengrass component version
 * built by `nx run <%- project %>:<%- componentDirName %>-artifact`.
 *
 * Re-running the generator re-syncs this file to its current build paths -
 * hand edits here do not survive a re-run.
 */
export class <%- componentNameClassName %> extends GreengrassComponentVersion {
  constructor(scope: Construct, id: string, props: <%- componentNameClassName %>Props) {
    super(scope, id, {
      recipesDir: url.fileURLToPath(
        new URL(
          '../../../../../../<%- recipesDirFromRoot %>',
          <% if (esm) { %>import.meta.url<% } else { %>require('url').pathToFileURL(__filename).href<% } %>,
        ),
      ),
      artifactsDir: url.fileURLToPath(
        new URL(
          '../../../../../../<%- artifactsDirFromRoot %>',
          <% if (esm) { %>import.meta.url<% } else { %>require('url').pathToFileURL(__filename).href<% } %>,
        ),
      ),
      bucket: props.bucket,
      removalPolicy: props.removalPolicy,
    });
  }
}
