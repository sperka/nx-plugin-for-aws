# Shared Greengrass artifact bucket for "<%- name %>"'s components<% if (artifactBucketImported) { %> (imported)<% } %>.
#
# A separate module from the deployment itself: a component's module needs
# this bucket's name before its component version can be created, and the
# deployment must be created only after that component version exists -
# bundling both concerns in one module would force a dependency cycle the
# moment a caller wires that ordering with `depends_on`.
#
# Created once and left alone afterwards, so edits here survive a re-run. Pass
# the artifact-bucket module's other variables (a fixed `bucket_name`, a
# narrower `token_exchange_key_prefix`) right here.
module "artifact_bucket" {
  source = "../../../core/greengrass/artifact-bucket"
<% if (artifactBucketImported) { %>
  existing_bucket_name = "<%- artifactBucketName %>"
<% } %><% if (!artifactBucketImported) { %>
  # Ties the created bucket's name to this deployment, so manual cleanup (or
  # a lost state file) has more to go on than a creation timestamp - see
  # core/greengrass/artifact-bucket's own bucket_name_prefix default for why
  # an AWS-generated "terraform-<random>" name is not the default.
  bucket_name_prefix = "<%- nameKebabCase %>-artifacts"
<% } %><% if (tokenExchangeRoleArn) { %>
  # checkov flags any assignment whose name contains "token" as a possible
  # secret. An IAM role ARN is an identifier, not a credential.
  #checkov:skip=CKV_SECRET_6:An IAM role ARN is not a secret
  token_exchange_role_arn = "<%- tokenExchangeRoleArn %>"
<% } %><% if (tokenExchangeRoleArn && tokenExchangeKeyPrefix) { %>
  token_exchange_key_prefix = "<%- tokenExchangeKeyPrefix %>"
<% } %>}

output "bucket_name" {
  value = module.artifact_bucket.bucket_name
}

output "bucket_arn" {
  value = module.artifact_bucket.bucket_arn
}
