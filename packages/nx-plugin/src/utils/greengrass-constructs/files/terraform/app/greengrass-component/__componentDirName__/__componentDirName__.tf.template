variable "bucket_name" {
  description = "Name of the shared artifact bucket this component version's artifact is uploaded to - typically the `bucket_name` output of a deployment's `<name>-artifact-bucket` module, whose own `depends_on` orders this upload after the bucket is hardened."
  type        = string
}

# Publishes the "<%- componentDisplayName %>" Greengrass component version
# built by `nx run <%- project %>:<%- componentDirName %>-artifact`.
#
# Created once and left alone afterwards, so edits here survive a re-run -
# which also means a re-run does NOT re-sync the build paths below. Update
# them here by hand if the component's own project or name changes.
module "component_version" {
  source = "../../../core/greengrass/component-version"

  recipes_dir   = "${path.module}/../../../../../../../<%- recipesDirFromRoot %>"
  artifacts_dir = "${path.module}/../../../../../../../<%- artifactsDirFromRoot %>"
  bucket_name   = var.bucket_name
}

output "component_name" {
  value = module.component_version.component_name
}

output "component_version" {
  value = module.component_version.component_version
}

output "arn" {
  value = module.component_version.arn
}
