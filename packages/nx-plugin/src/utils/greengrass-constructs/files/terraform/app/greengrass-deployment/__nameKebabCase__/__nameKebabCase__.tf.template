variable "components" {
  description = "Components to deploy, keyed by ComponentName. Populated from <%- componentsJsonPathFromRoot %> by default, which the 'connection' generator keeps in sync - pass a value here only to override that file."
  type = map(object({
    component_version = optional(string)
    configuration_update = optional(object({
      merge = optional(string)
      reset = optional(list(string))
    }))
    run_with = optional(object({
      posix_user   = optional(string)
      windows_user = optional(string)
      system_resource_limits = optional(object({
        cpus   = optional(number)
        memory = optional(number)
      }))
    }))
  }))
  default = null
}

variable "component_versions" {
  description = "Resolved versions overriding the entries' component_version. Wire each NEXT_* component's module output here; this also orders the deployment after that component version."
  type        = map(string)
  default     = {}
}

locals {
  component_entries = var.components != null ? var.components : jsondecode(file("${path.module}/../../../../../../../<%- componentsJsonPathFromRoot %>"))
  # `try`: a components.json entry carrying only `configuration_update` has
  # no `component_version` attribute at all, where the typed variable above
  # fills it in with null.
  components = {
    for name, entry in local.component_entries : name => merge(entry, {
      component_version = lookup(var.component_versions, name, try(entry.component_version, null))
    })
  }
  unknown_component_versions = setsubtract(keys(var.component_versions), keys(local.component_entries))
}

# A `component_versions` key naming no entry in `components` is a typo: the
# override would be dropped silently and the deployment would carry the entry's
# own version. Fails the plan instead, as the CDK construct fails synth.
resource "terraform_data" "component_versions_guard" {
  lifecycle {
    precondition {
      condition     = length(local.unknown_component_versions) == 0
      error_message = "component_versions names ${join(", ", local.unknown_component_versions)}, but components has no entry by that name."
    }
  }
}

# Greengrass deployment infrastructure generated by `greengrass-deployment`
# for "<%- name %>": a deployment targeting <%- targetDescription %>. The
# artifact bucket lives in the sibling `<%- nameKebabCase %>-artifact-bucket`
# module - see that module's file for why it is not bundled here.
#
# Created once and left alone afterwards, so edits here survive a re-run -
# which also means a re-run with different options does NOT re-sync this file.
# Change an option (the deployment target, its policies) right here.
#
# Wire every NEXT_* component through `component_versions` using its module
# output; that reference orders the deployment after the component version.
# `depends_on = [module.<component>]` remains needed for a component whose
# version is not wired through `component_versions`.
module "deployment" {
  source = "../../../core/greengrass/deployment"

  <%- targetPropLineTf %>
<% if (parentTargetArn) { %>
  parent_target_arn = "<%- parentTargetArn %>"
<% } %><% if (deploymentPoliciesLiteralTf) { %>
  deployment_policies = <%- deploymentPoliciesLiteralTf %>
<% } %>
  components = local.components
}

output "target_arn" {
  value = module.deployment.target_arn
}

output "deployment_id" {
  value = module.deployment.deployment_id
}
