variable "components" {
  description = "Components to deploy, keyed by ComponentName. Populated from <%- componentsJsonPathFromRoot %> by default, which the greengrass-deployment#component-connection generator keeps in sync - pass a value here only to override that file."
  type = map(object({
    component_version = optional(string)
    configuration_update = optional(object({
      merge = optional(string)
      reset = optional(list(string))
    }))
    run_with = optional(object({
      posix_user   = optional(string)
      windows_user = optional(string)
      system_resource_limits = optional(object({
        cpus   = optional(number)
        memory = optional(number)
      }))
    }))
  }))
  default = null
}

locals {
  components = var.components != null ? var.components : jsondecode(file("${path.module}/../../../../../../../<%- componentsJsonPathFromRoot %>"))
}

# Greengrass deployment infrastructure generated by `greengrass-deployment`
# for "<%- name %>": a deployment targeting <%- targetDescription %>. The
# artifact bucket lives in the sibling `<%- nameKebabCase %>-artifact-bucket`
# module - see that module's file for why it is not bundled here.
#
# Re-running the generator re-syncs this file to its current options - hand
# edits here do not survive a re-run. Depend this module on every component
# module it references in `components` (`depends_on = [module.<component>]`
# on this module block in your own root module), mirroring the CDK
# construct's `.dependOn()` call - otherwise the deployment can reach devices
# before a referenced component version exists in the registry.
module "deployment" {
  source = "../../../core/greengrass/deployment"

  <%- targetPropLineTf %>
<% if (parentTargetArn) { %>  parent_target_arn = "<%- parentTargetArn %>"
<% } %><% if (deploymentPoliciesLiteralTf) { %>  deployment_policies = <%- deploymentPoliciesLiteralTf %>
<% } %>  components = local.components
}

output "target_arn" {
  value = module.deployment.target_arn
}

output "deployment_id" {
  value = module.deployment.deployment_id
}
