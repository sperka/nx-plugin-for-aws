  "apps/test_project/tests/greengrass/test_my_component.py": "import importlib.util
from pathlib import Path

# main.py lives beside recipe.yaml under greengrass/<component>/, outside this
# project's importable package, so it is loaded directly by file path.
PROJECT_ROOT = Path(__file__).resolve().parents[2]
MAIN_PATH = PROJECT_ROOT / "greengrass" / "my-component" / "main.py"


def _load_main():
    spec = importlib.util.spec_from_file_location("my_component_main", MAIN_PATH)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def test_publish_heartbeat_publishes_to_own_topic():
    module = _load_main()
    calls = []

    class FakeClient:
        def publish_to_topic(self, **kwargs):
            calls.append(kwargs)

    module.publish_heartbeat(FakeClient(), 1)

    assert len(calls) == 1
    assert calls[0]["topic"] == module.TOPIC
    assert module.TOPIC == "com.proj.MyComponent/heartbeat"
",
