  "apps/test_project/greengrass/my-component/main.py": "import logging
import time

from awsiot.greengrasscoreipc.clientv2 import GreengrassCoreIPCClientV2
from awsiot.greengrasscoreipc.model import JsonMessage, PublishMessage

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger("com.proj.MyComponent")

TOPIC = "com.proj.MyComponent/heartbeat"
PUBLISH_INTERVAL_SECONDS = 30


def publish_heartbeat(client: GreengrassCoreIPCClientV2, sequence: int) -> None:
    client.publish_to_topic(
        topic=TOPIC,
        publish_message=PublishMessage(
            json_message=JsonMessage(message={"sequence": sequence})
        ),
    )
    logger.info("Published heartbeat %s to %s", sequence, TOPIC)


def main() -> None:
    client = GreengrassCoreIPCClientV2()
    sequence = 0
    while True:
        publish_heartbeat(client, sequence)
        sequence += 1
        time.sleep(PUBLISH_INTERVAL_SECONDS)


if __name__ == "__main__":
    main()
",
  "apps/test_project/greengrass/my-component/recipe.yaml": "RecipeFormatVersion: '2020-01-25'
ComponentName: com.proj.MyComponent
ComponentVersion: 1.0.0
ComponentDescription: com.proj.MyComponent Greengrass component, generated by py#greengrass-component.
ComponentPublisher: proj
ComponentConfiguration:
  DefaultConfiguration:
    accessControl:
      aws.greengrass.ipc.pubsub:
        com.proj.MyComponent:pubsub:1:
          policyDescription: Allow publishing heartbeat messages to this component's own topic.
          operations:
            - aws.greengrass#PublishToTopic
          resources:
            - com.proj.MyComponent/heartbeat
Manifests:
  - Platform:
      os: linux
      architecture: arm64
    Artifacts:
      # Placeholders are substituted at publish time. The basename must stay
      # my-component.zip, which is what the Run script below unarchives to.
      - Uri: s3://BUCKET_NAME/COMPONENT_NAME/COMPONENT_VERSION/my-component.zip
        Unarchive: ZIP
    Lifecycle:
      Run: python3 {artifacts:decompressedPath}/my-component/main.py
