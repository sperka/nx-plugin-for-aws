        "command": "tsx packages/common/scripts/src/greengrass/deploy-local.ts dist/{projectRoot}/greengrass/my-component"
      }
    },
    "my-component-logs": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "tsx packages/common/scripts/src/greengrass/component-logs.ts com.proj.MyComponent"
      }
    }
  }
}
