          "uv pip install -n --no-deps --no-installer-metadata --no-compile-bytecode --only-binary :all: --python-platform aarch64-manylinux_2_28 --python-version 3.14 --target dist/{projectRoot}/greengrass/my-component/vendor -r dist/{projectRoot}/greengrass/my-component/vendor/requirements.txt"
        ],
        "parallel": false
      }
    },
    "my-component-artifact": {
      "executor": "nx:run-commands",
      "dependsOn": ["my-component-vendor"],
      "cache": true,
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}/greengrass/my-component/greengrass-build"
      ],
      "options": {
        "command": "tsx packages/common/scripts/src/greengrass/build-artifact.ts {projectRoot} my-component dist/{projectRoot}/greengrass/my-component"
      }
    },
    "build": {
      "dependsOn": ["my-component-artifact"]
    },
    "assemble": {
