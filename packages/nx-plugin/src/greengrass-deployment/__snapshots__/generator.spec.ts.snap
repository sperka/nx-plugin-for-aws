// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`greengrass-deployment generator > should generate the deployment library and CDK infrastructure 1`] = `
"/**
 * A component to deploy as part of "MyDeployment", and the configuration
 * update to merge or reset on target devices.
 *
 * Mirrors \`GreengrassDeploymentComponent\` from the vended
 * \`common/constructs\` \`GreengrassDeployment\` construct. Duplicated
 * deliberately rather than imported: this project stays independent of
 * \`common/constructs\`, which is a leaf every infra app depends on and must
 * never depend back on a specific deployment's own library.
 */
export interface DeploymentComponent {
  readonly componentVersion?: string;
  readonly configurationUpdate?: {
    readonly merge?: Record<string, unknown>;
    readonly reset?: readonly string[];
  };
}

/**
 * Components this deployment installs, keyed by \`ComponentName\`. Add an
 * entry per component you deploy, then pass this map to the
 * \`MyDeployment\` app construct's \`components\` prop from your infra
 * stack (\`packages/common/constructs/src/app/greengrass/my-deployment.ts\`).
 *
 * User-owned from first generation onward - re-running this generator leaves
 * your entries alone.
 */
export const components: Record<string, DeploymentComponent> = {
  // 'com.example.MyComponent': { componentVersion: '1.0.0' },
};
"
`;

exports[`greengrass-deployment generator > should generate the deployment library and CDK infrastructure 2`] = `
"export * from './components.js';
"
`;

exports[`greengrass-deployment generator > should generate the deployment library and CDK infrastructure 3`] = `
"import { Construct } from 'constructs';
import {
  GreengrassArtifactBucket,
  GreengrassDeployment,
  type GreengrassDeploymentComponent,
} from '../../core/greengrass/index.js';

export interface MyDeploymentProps {
  /**
   * Components to deploy, keyed by \`ComponentName\`. Typically imported from
   * this deployment's typed component library
   * (\`@proj/my-deployment\`).
   */
  readonly components?: Record<string, GreengrassDeploymentComponent>;
}

/**
 * Greengrass deployment infrastructure generated by \`greengrass-deployment\`
 * for "MyDeployment": a dedicated artifact bucket and
 * a deployment targeting a new thing group ("my-things").
 *
 * Re-running the generator re-syncs this file to its current options - hand
 * edits here do not survive a re-run. Add your own constructs alongside it in
 * your infra stack instead.
 */
export class MyDeployment extends Construct {
  public readonly artifactBucket: GreengrassArtifactBucket;
  public readonly deployment: GreengrassDeployment;

  constructor(scope: Construct, id: string, props: MyDeploymentProps = {}) {
    super(scope, id);

    this.artifactBucket = new GreengrassArtifactBucket(
      this,
      'ArtifactBucket',
      {},
    );

    this.deployment = new GreengrassDeployment(this, 'Deployment', {
      thingGroupName: 'my-things',
      components: props.components,
    });
  }
}
"
`;

