terraform {
  required_version = ">= 1.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "<%- awsProviderVersion %>"
    }
    awscc = {
      source  = "hashicorp/awscc"
      version = "<%- awsccProviderVersion %>"
    }
    null = {
      source  = "hashicorp/null"
      version = "<%- nullProviderVersion %>"
    }
  }

  backend "s3" {
    encrypt      = true
    use_lockfile = true
  }
}

provider "aws" {
  region = var.aws_region
}

# Configured here even by a workspace using no awscc resource. A module
# requiring a provider the root leaves unconfigured gets an empty default
# configuration, which resolves its region from the ambient environment - so
# without this block a vended module using awscc (Greengrass) would deploy into
# whatever AWS_REGION happens to be set rather than var.aws_region.
provider "awscc" {
  region = var.aws_region
}

data "aws_caller_identity" "current" {}
data "aws_region" "current" {}